generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model menu {
  id           BigInt         @id @default(autoincrement())
  name         String         @db.VarChar(30)
  description  String?        @db.VarChar(150)
  calory       BigInt?
  carbo        BigInt?
  protein      BigInt?
  fat          BigInt?
  sodium       BigInt?
  image_link   String?
  battle_menu  battle_menu[]
  menu_allery  menu_allery[]
  menu_tag     menu_tag[]
  menu_vitamin menu_vitamin[]
  mukburim     mukburim[]
  spin_result  spin_result[]
}

model mukburim {
  id      BigInt    @id
  menu_id BigInt
  user_id BigInt
  date    DateTime? @db.DateTime(0)
  menu    menu      @relation(fields: [menu_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "mukburim_menu_id_fk")

  @@index([menu_id], map: "mukburim_menu_id_fk")
}

model menu_tag {
  id      BigInt  @id @default(autoincrement())
  menu_id BigInt
  tag     String? @db.VarChar(40)
  menu    menu    @relation(fields: [menu_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "menu_tag_ibfk_1")

  @@index([menu_id], map: "menu_tag_menu_id_fk")
}

model battle {
  id                 String               @id @db.VarChar(36)
  creater_nickname   String?              @db.VarChar(50)
  status             String?              @db.VarChar(20)
  participant_count  Int?
  created_at         DateTime?            @db.DateTime(0)
  finished_at        DateTime?            @db.DateTime(0)
  expires_at         DateTime?            @db.DateTime(0)
  battle_menu        battle_menu[]
  battle_participant battle_participant[]
  spin_result        spin_result[]
}

model battle_menu {
  id             BigInt  @id @default(autoincrement())
  menu_name      String? @db.VarChar(50)
  boundary_angle Float?
  menu_order     Int?
  battle_id      String  @db.VarChar(36)
  menu_id        BigInt
  battle         battle  @relation(fields: [battle_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "battle_menu_battle_id_fk")
  menu           menu    @relation(fields: [menu_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "battle_menu_menu_id_fk")

  @@index([battle_id], map: "battle_menu_battle_id_fk")
  @@index([menu_id], map: "battle_menu_menu_id_fk")
}

model battle_participant {
  battle_id  String    @db.VarChar(36)
  user_id    BigInt
  nickname   String?   @db.VarChar(50)
  is_creater Int?      @db.TinyInt
  joined_at  DateTime? @db.DateTime(0)
  battle     battle    @relation(fields: [battle_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "battle_participant_battle_id_fk")

  @@id([user_id, battle_id])
  @@index([battle_id], map: "battle_participant_battle_id_fk")
}

model menu_allery {
  menu_id    BigInt
  allergy_id BigInt
  allery     allergy @relation(fields: [allergy_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "menu_allery_allery_id_fk")
  menu       menu    @relation(fields: [menu_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "menu_allery_menu_id_fk")

  @@id([menu_id, allergy_id])
  @@index([allergy_id], map: "menu_allery_allery_id_fk")
}

model menu_vitamin {
  menu_id    BigInt
  vitamin_id BigInt
  menu       menu    @relation(fields: [menu_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "menu_vitamin_menu_id_fk")
  vitamin    vitamin @relation(fields: [vitamin_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "menu_vitamin_vitamin_id_fk")

  @@id([menu_id, vitamin_id])
  @@index([vitamin_id], map: "menu_vitamin_vitamin_id_fk")
}

model spin_result {
  id                   BigInt    @id @default(autoincrement())
  nickname             String?   @db.VarChar(50)
  stopped_angle        Float?
  distance_to_boundary Float?
  rank                 Int?
  spin_at              DateTime? @db.DateTime(0)
  battle_id            String    @db.VarChar(36)
  closest_menu_id      BigInt
  battle               battle    @relation(fields: [battle_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "spin_result_battle_id_fk")
  menu                 menu      @relation(fields: [closest_menu_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "spin_result_menu_id_fk")

  @@index([battle_id], map: "spin_result_battle_id_fk")
  @@index([closest_menu_id], map: "spin_result_menu_id_fk")
}

model vitamin {
  id           BigInt         @id @default(autoincrement())
  vitamin      String?        @db.VarChar(50)
  menu_vitamin menu_vitamin[]
}

model allergy {
  id          BigInt        @id @default(autoincrement())
  allergy     String?       @db.VarChar(50)
  menu_allery menu_allery[]
}

model sessions {
  session_id String  @id @db.VarChar(128)
  expires    Int     @db.UnsignedInt
  data       String? @db.MediumText
}
