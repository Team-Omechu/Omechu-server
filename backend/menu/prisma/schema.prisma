generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model allergy {
  id           BigInt         @id @default(autoincrement())
  allergy      String?        @db.VarChar(50)
  menu_allergy menu_allergy[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model battle_menus {
  id             BigInt  @id @default(autoincrement())
  battle_id      String  @db.VarChar(36)
  menu_id        BigInt
  menu_name      String  @db.VarChar(50)
  boundary_angle Decimal @db.Decimal(5, 2)
  menu_order     Int
  battles        battles @relation(fields: [battle_id], references: [battle_id], onDelete: Cascade, map: "fk_bm_battle")
  menu           menu    @relation(fields: [menu_id], references: [id], onDelete: Cascade, map: "fk_bm_menu")

  @@unique([battle_id, menu_id], map: "uk_battle_menu")
  @@index([battle_id], map: "idx_battle_id")
  @@index([menu_id], map: "idx_menu_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model battle_participants {
  id         BigInt   @id @default(autoincrement())
  battle_id  String   @db.VarChar(36)
  nickname   String   @db.VarChar(50)
  is_creator Boolean  @default(false)
  joined_at  DateTime @default(now()) @db.DateTime(0)
  battles    battles  @relation(fields: [battle_id], references: [battle_id], onDelete: Cascade, map: "fk_bp_battle")

  @@unique([battle_id, nickname], map: "uk_battle_nickname")
  @@index([battle_id], map: "idx_battle_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model battles {
  battle_id           String                @id @db.VarChar(36)
  creator_nickname    String                @db.VarChar(50)
  status              battles_status        @default(active)
  participant_count   Int                   @default(0)
  created_at          DateTime              @default(now()) @db.DateTime(0)
  finished_at         DateTime?             @db.DateTime(0)
  expires_at          DateTime              @db.DateTime(0)
  battle_menus        battle_menus[]
  battle_participants battle_participants[]
  spin_results        spin_results[]

  @@index([created_at], map: "idx_created_at")
  @@index([expires_at], map: "idx_expires_at")
  @@index([status], map: "idx_status")
}

model menu {
  id           BigInt         @id @default(autoincrement())
  name         String         @db.VarChar(30)
  description  String?        @db.VarChar(150)
  calory       BigInt?
  carbo        BigInt?
  protein      BigInt?
  fat          BigInt?
  sodium       BigInt?
  image_link   String?
  battle_menus battle_menus[]
  menu_allergy menu_allergy[]
  menu_tag     menu_tag[]
  menu_vitamin menu_vitamin[]
  mukburim     mukburim[]
  spin_results spin_results[]
}

model menu_allergy {
  menu_id    BigInt
  allergy_id BigInt
  allergy    allergy @relation(fields: [allergy_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "menu_allergy_allergy_id_fk")
  menu       menu    @relation(fields: [menu_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "menu_allergy_menu_id_fk")

  @@id([menu_id, allergy_id])
  @@index([allergy_id], map: "menu_allergy_allergy_id_fk")
}

model menu_tag {
  id      BigInt  @id @default(autoincrement())
  menu_id BigInt
  tag     String? @db.VarChar(40)
  menu    menu    @relation(fields: [menu_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "menu_tag_menu_id_fk")

  @@index([menu_id], map: "menu_tag_menu_id_fk")
}

model menu_vitamin {
  menu_id    BigInt
  vitamin_id BigInt
  menu       menu    @relation(fields: [menu_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "menu_vitamin_menu_id_fk")
  vitamin    vitamin @relation(fields: [vitamin_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "menu_vitamin_vitamin_id_fk")

  @@id([menu_id, vitamin_id])
  @@index([vitamin_id], map: "menu_vitamin_vitamin_id_fk")
}

model mukburim {
  id      BigInt    @id @default(autoincrement())
  menu_id BigInt
  user_id BigInt
  date    DateTime? @db.DateTime(0)
  menu    menu      @relation(fields: [menu_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "mukburim_menu_id_fk")

  @@index([menu_id], map: "mukburim_menu_id_fk")
}

model sessions {
  session_id String  @id @db.VarChar(128)
  expires    Int     @db.UnsignedInt
  data       String? @db.MediumText
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model spin_results {
  id                   BigInt   @id @default(autoincrement())
  battle_id            String   @db.VarChar(36)
  nickname             String   @db.VarChar(50)
  stopped_angle        Decimal  @db.Decimal(5, 2)
  closest_menu_id      BigInt
  closest_menu_name    String   @db.VarChar(50)
  distance_to_boundary Decimal  @db.Decimal(5, 2)
  rank                 Int
  spun_at              DateTime @default(now()) @db.DateTime(0)
  battles              battles  @relation(fields: [battle_id], references: [battle_id], onDelete: Cascade, map: "fk_sr_battle")
  menu                 menu     @relation(fields: [closest_menu_id], references: [id], onDelete: Cascade, map: "fk_sr_menu")

  @@unique([battle_id, nickname], map: "uk_battle_nickname")
  @@index([closest_menu_id], map: "fk_sr_menu")
  @@index([battle_id], map: "idx_battle_id")
  @@index([distance_to_boundary], map: "idx_distance")
  @@index([rank], map: "idx_rank")
  @@index([spun_at], map: "idx_spun_at")
}

model vitamin {
  id           BigInt         @id @default(autoincrement())
  vitamin      String?        @db.VarChar(50)
  menu_vitamin menu_vitamin[]
}

enum battles_status {
  waiting
  active
  finished
}
