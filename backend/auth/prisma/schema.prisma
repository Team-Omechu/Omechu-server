generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model auth_user {
  id       BigInt  @id @default(autoincrement())
  email    String? @db.VarChar(30)
  password String? @db.VarChar(100)
}
