generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model auth_user {
  id          BigInt    @id @default(autoincrement())
  email       String?   @db.VarChar(100)
  password    String?   @db.VarChar(100)
  provider    String    @default("local") @db.VarChar(20)
  provider_id String?   @unique(map: "uk_auth_user_provider_id") @db.VarChar(64)
  is_deleted  Boolean?  @default(false)
  deleted_at  DateTime? @db.DateTime(0)
}

model email_verification {
  email      String   @id @db.VarChar(255)
  code       String   @db.VarChar(10)
  expires_at DateTime @db.DateTime(0)
  created_at DateTime @default(now()) @db.DateTime(0)
  updated_at DateTime @default(now()) @db.DateTime(0)
}

model password_reset_token {
  email      String   @unique(map: "uk_password_reset_email") @db.VarChar(255)
  token      String   @id @db.VarChar(255)
  expires_at DateTime @db.DateTime(0)
  created_at DateTime @default(now()) @db.DateTime(0)
  updated_at DateTime @default(now()) @db.DateTime(0)
}
