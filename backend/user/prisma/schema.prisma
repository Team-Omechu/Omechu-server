generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model user {
  id                BigInt             @id
  phone_num         String?            @db.VarChar(21)
  nickname          String?            @db.VarChar(30)
  exercise          user_exercise?
  is_deleted        Boolean?           @default(false)
  deleted_at        DateTime?          @db.DateTime(0)
  agreement_consent agreement_consent?
  prefer            prefer[]
  user_allergy      user_allergy[]
}

model agreement_consent {
  id                BigInt    @id @default(autoincrement())
  user_id           BigInt    @unique(map: "uk_agreement_user")
  terms_of_service  Boolean?
  privacy_policy    Boolean?
  location_service  Boolean?
  is_over14         Boolean?
  created_at        DateTime? @db.DateTime(0)
  marketing_consent Boolean?
  user              user      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "agreement_consent_user_fk")
}

model allergy_min {
  id           BigInt         @id @default(autoincrement())
  allergy      String?        @db.VarChar(255)
  user_allergy user_allergy[]
}

model inquiry {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  title      String?   @db.VarChar(100)
  content    String?   @db.Text
  created_at DateTime? @db.DateTime(0)

  @@index([user_id], map: "inquiry_user_id_fk")
}

model meal_alert {
  user_id    BigInt
  meal_id    BigInt
  enabled    Boolean?
  alarm_time DateTime? @db.Time(0)
  meal_time  meal_time @relation(fields: [meal_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "meal_alert_meal_time_id_fk")

  @@id([user_id, meal_id])
  @@index([meal_id], map: "meal_alert_meal_time_id_fk")
}

model meal_time {
  id         BigInt       @id @default(autoincrement())
  alert_time DateTime?    @db.Time(0)
  comment    String?      @db.VarChar(20)
  meal_alert meal_alert[]
}

model user_allergy {
  user_id     BigInt
  allergy_id  BigInt
  allergy_min allergy_min @relation(fields: [allergy_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_allergy_allergy_min_id_fk")
  user        user        @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_allergy_user_id_fk")

  @@id([user_id, allergy_id])
  @@index([allergy_id], map: "user_allergy_allergy_min_id_fk")
}

model sessions {
  session_id String  @id @db.VarChar(128)
  expires    Int     @db.UnsignedInt
  data       String? @db.MediumText
}

model prefer {
  id      BigInt        @id @default(autoincrement())
  prefer  prefer_prefer
  user_id BigInt
  user    user          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_prefer_user")

  @@index([user_id], map: "fk_prefer_user")
}

model recommend_except {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  menu_id    BigInt
  bit        Boolean?  @default(true)
  created_at DateTime? @default(now()) @db.DateTime(0)

  @@unique([user_id, menu_id], map: "uk_user_menu")
  @@index([menu_id], map: "idx_recommend_except_menu")
  @@index([user_id], map: "idx_recommend_except_user")
}

model user_withdrawal {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  reason     String   @db.VarChar(100)
  created_at DateTime @default(now()) @db.DateTime(0)
}

enum user_exercise {
  dieting     @map("다이어트 중")
  bulking     @map("증량 중")
  maintaining @map("유지 중")
}

enum prefer_prefer {
  korean
  western
  chinese
  japanese
  other
}
