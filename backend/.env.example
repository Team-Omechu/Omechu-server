# ===========================================
# Omechu Backend Environment Variables
# ===========================================
# 이 파일을 복사하여 .env 파일을 생성하세요
# cp .env.example .env

# Server
PORT=3000

# Database
DB_HOST=omechu_db
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DATABASE_URL=mysql://your_db_user:your_db_password@omechu_db:3306/your_db_name

# AWS S3
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
AWS_S3_BUCKET_NAME=omechu-service-s3-bucket

# Session
SESSION_SECRET=your_session_secret

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Kakao API
KAKAO_REST_API_KEY=your_kakao_rest_api_key
KAKAO_LOGIN_REST_API_KEY=your_kakao_login_rest_api_key
KAKAO_REDIRECT_URI=https://omechu-api.log8.kr/auth/kakao/callback
KAKAO_CLIENT_SECRET=your_kakao_client_secret

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Mail (Gmail)
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password

# JWT
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=1d

# Redis
REDIS_HOST=my_redis
REDIS_PORT=6379
